<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Template isFullResponsive="true">
    <Name>Flex</Name>
    <Author>Themeart GmbH</Author>
    <URL>https://www.themeart.de</URL>
    <Parent>Beat</Parent>
    <Preview>preview.png</Preview>
    <Version>1.0.0</Version>
    <MinShopVersion>5.2.0</MinShopVersion>
    <Description>Das Flex-Theme ist das Child-Template für eigene Anpassungen.</Description>
    <Settings>
        <Section Name="Theme" Key="theme">
            <Setting Description="Theme" Key="theme_default" Type="select" Value="flex" override="true">
                <Option Value="flex">Flex</Option>
            </Setting>
        </Section>
    </Settings>
    <Minify>
        <CSS Name="flex.css">
            <File Path="themes/flex/flex.css"/>
            <File Path="themes/flex/custom.css"/>
        </CSS>
    </Minify>
    <Boxes>
        <Container Position="left" Available="1" />
        <Container Position="right" Available="0" />
        <Container Position="top" Available="0" />
        <Container Position="bottom" Available="1" />
    </Boxes>
</Template>
